{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tool_registry.json",
  "description": "本机已知信息源注册表（Step 2 盘点必须覆盖）",
  "type": "object",
  "required": ["version", "sources"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["api", "registry", "http", "agent", "plugin"] },
          "tools": { "type": "array", "items": { "type": "string" } },
          "discover": { "type": "string", "description": "registry 类型的 discover 入口" },
          "call": { "type": "string", "description": "registry 类型的 call 入口" },
          "note": { "type": "string" }
        }
      }
    },
    "rules": {
      "type": "object",
      "description": "tool_inventory.py 据此校验"
    }
  }
}