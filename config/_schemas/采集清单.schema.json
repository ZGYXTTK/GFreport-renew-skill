{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "采集清单.json",
  "description": "每月只改「截至日期」，采集逻辑直接复跑",
  "type": "object",
  "required": ["version", "截至日期", "items"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "截至日期": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "类型", "通道", "口径"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "类型": { "enum": ["时点型", "半结构型", "结构型"] },
          "通道": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "通道名必须存在于 endpoints.json 的 http/mcp/agent 或 tool_registry.json"
          },
          "口径": { "type": "string", "minLength": 1 },
          "枚举": { "type": "string" },
          "输出": { "type": "string" },
          "注意": { "type": "string" }
        }
      }
    }
  }
}